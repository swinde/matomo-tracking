<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/shopware/shopware/trunk/src/Core/System/SystemConfig/Schema/config.xsd">

    <card>
        <title>Matomo Tracking</title>
        <title lang="en-GB">Matomo Tracking</title>

        <input-field type="bool">
            <name>active</name>
            <label>Matomo aktivieren</label>
            <defaultValue>false</defaultValue>
        </input-field>

        <input-field type="text">
            <name>baseUrl</name>
            <label>Matomo Server URL</label>
            <helpText>
                Beispiel: https://analytics.example.de/
            </helpText>
        </input-field>

        <input-field type="int">
            <name>siteId</name>
            <label>Matomo Site-ID</label>
            <defaultValue>1</defaultValue>
        </input-field>

        <input-field type="bool">
            <name>trackEcommerce</name>
            <label>E-Commerce-Tracking</label>
            <defaultValue>true</defaultValue>
        </input-field>

        <input-field type="bool">
            <name>anonymizeIp</name>
            <label>IP-Adressen anonymisieren</label>
            <defaultValue>true</defaultValue>
        </input-field>

    </card>
</config>